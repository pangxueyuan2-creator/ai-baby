# Offline by default. Merely setting a key does NOT enable external requests.
AI_BABY_PROVIDER=mock
# Providers:
#   mock               -> no model/network, rules + local retrieval only
#   ollama             -> loopback-only local LLM preset; no API key or external opt-in needed
#   grok               -> xAI Chat Completions at api.x.ai; requires opt-in + key + model
#   openai-compatible  -> remote/custom Chat Completions endpoint; requires explicit opt-in below
AI_BABY_ALLOW_EXTERNAL=false
AI_BABY_API_KEY=
# Leave blank for provider defaults:
#   ollama -> http://127.0.0.1:11434/v1
#   grok -> https://api.x.ai/v1
#   openai-compatible -> https://api.openai.com/v1
AI_BABY_BASE_URL=
# Set a model ID supported by your chosen service. No model is silently selected.
AI_BABY_MODEL=
AI_BABY_TIMEOUT=30
# Only explicit HTTP 429 rejections are retryable. Total generation deadline = TIMEOUT.
AI_BABY_MAX_RETRIES=0
AI_BABY_RETRY_BACKOFF=0.25
# Optional; default is ~/.ai-baby (Windows: %USERPROFILE%\.ai-baby).
# AI_BABY_DATA_DIR=./data
